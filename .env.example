# 모델 설정 — 공급자 표는 src/providers.ts (기존 구현 의 PROVIDERS 를 그대로 옮긴 것, 25개).
#
# 둘 중 하나:
#   (A) 공급자 프리셋 — PROVIDER 와 그 공급자의 키만 지정하면 주소·전송 방식·인증 헤더가 표에서 채워진다.
#       기본 모델이 없는 공급자(openai·openrouter·groq 등 목록을 받아오는 곳)는 MODEL 도 지정한다.
#   (B) 직접 지정 — BASE_URL / API_KEY / MODEL 을 모두 쓴다(PROVIDER 를 함께 주면 전송·헤더는 표를 따른다).
#
# PROVIDER: deepseek kimi openai openrouter groq mistral xai together gemini deepinfra novita fireworks
#           dashscope nebius chutes hyperbolic featherless vercel-gateway cerebras sambanova baseten
#           anthropic openai-compatible opencodex ollama
# 키 환경변수: DEEPSEEK_API_KEY MOONSHOT_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY GROQ_API_KEY MISTRAL_API_KEY
#           XAI_API_KEY TOGETHER_API_KEY GEMINI_API_KEY DEEPINFRA_API_KEY NOVITA_API_KEY FIREWORKS_API_KEY
#           DASHSCOPE_API_KEY NEBIUS_API_KEY CHUTES_API_KEY HYPERBOLIC_API_KEY FEATHERLESS_API_KEY
#           AI_GATEWAY_API_KEY CEREBRAS_API_KEY SAMBANOVA_API_KEY BASETEN_API_KEY ANTHROPIC_API_KEY OPENCODEX_API_KEY
#           (ollama·openai-compatible 은 키가 선택)
LEGAL_AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# (B) 프리셋을 쓰지 않을 때
# LEGAL_AGENT_BASE_URL=https://api.deepseek.com
# LEGAL_AGENT_API_KEY=
# LEGAL_AGENT_MODEL=deepseek-flash

# 생성 파라미터 (기본값: 0.3 / 8192). top_p·seed 는 비우면 보내지 않는다(공급자 기본).
# seed 는 OpenAI 호환 전송에만 간다(DeepSeek·Anthropic 은 받아도 버린다).
# LEGAL_AGENT_TEMPERATURE=0.3
# LEGAL_AGENT_MAX_TOKENS=8192
# LEGAL_AGENT_TOP_P=0.9
# LEGAL_AGENT_SEED=42

# 역할별 모델 — 판정을 다른 공급자로(같은 모델끼리의 상관을 줄인다). 접미: PLANNER WORKER CON JUDGE CHAPTER …
# LEGAL_AGENT_PROVIDER_JUDGE=anthropic
# LEGAL_AGENT_MODEL_JUDGE=claude-sonnet-4-5
# LEGAL_AGENT_BASE_URL_JUDGE=https://api.anthropic.com/v1
# LEGAL_AGENT_API_KEY_JUDGE=

# testset-direction 전용 판정 모델 — scripts/testset-direction.mts 만 읽는다(파이프라인은 읽지 않는다).
# 위 LEGAL_AGENT_*_JUDGE 는 파이프라인의 판정·인용 검사 역할도 바꿔 testset-run 이 시험하는 파이프라인이 달라지므로,
# 결론 방향을 집필과 다른 모델로 판정하려면 이쪽을 쓴다. 하나라도 주면 그 값만 쓰고(LEGAL_AGENT_*_JUDGE 와 섞지 않음),
# 키·모델이 없어 프로파일을 만들지 못하면 집필 모델로 판정하지 않고 멈춘다(results/ 를 건드리지 않음).
# TESTSET_JUDGE_PROVIDER=anthropic
# TESTSET_JUDGE_MODEL=claude-sonnet-4-5
# TESTSET_JUDGE_BASE_URL=
# TESTSET_JUDGE_API_KEY=

# ---- 원문 확보 ------------------------------------------------------------------
# 사전제공 파일 디렉터리 (콜론으로 구분). data/corpus 는 항상 포함된다.
# LEGAL_AGENT_CORPUS=/path/to/legalize

# Unpaywall 은 연락처 이메일을 요구한다. 없으면 Crossref 단계에서 DOI/서지 정보까지만 간다.
# LEGAL_AGENT_CONTACT_EMAIL=you@example.com

# KCI OpenAPI (한국 학술지 서지·초록) — 선택
# 인증키가 없으면 KCI 검색을 건너뛴다. 아래에서 신청해 KCI_API_KEY로 넣는다.
# https://www.kci.go.kr/kciportal/po/openapi/  → 인증키 신청/관리
# KCI_API_KEY=
