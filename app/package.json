{
  "name": "nenene",
  "productName": "Nenene",
  "version": "0.1.0",
  "private": true,
  "description": "LLM 저자 · 적대적 검토 파이프라인으로 법학논문을 쓰는 데스크톱 앱",
  "main": "out/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/launch.mjs",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/launch.mjs --dev\"",
    "selftest": "npm run build && node scripts/launch.mjs --selftest",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac --dir",
    "dist:dmg": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "author": "Nenene"
}
